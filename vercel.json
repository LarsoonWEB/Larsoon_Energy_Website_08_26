{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/rjesenja",
      "destination": "/#rjesenja",
      "permanent": false
    },
    {
      "source": "/usluge",
      "destination": "/#usluge",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)\\.(jpg|png|webp|avif|svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/assets/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
