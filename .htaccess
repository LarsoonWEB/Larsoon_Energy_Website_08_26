# Larsoon — čiste rute za pravne stranice (Plus hosting / Apache)
RewriteEngine On

# /pravila-privatnosti → pravila-privatnosti.html itd.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

# Preusmjeri .html verzije na čistu rutu (izbjegavanje dupliciranog sadržaja)
RewriteCond %{THE_REQUEST} \s/([^.]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]
